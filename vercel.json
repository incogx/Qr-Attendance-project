{
  "version": 2,
  "builds": [
    {
      "src": "Attendence-Admin-Portal/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "Attendence-Admin-Portal/dist/index.html" }
  ]
}
